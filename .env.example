# Copy this file to .env and fill in your values

# WhisperX API
WHISPERX_API_URL=https://wsp.kingdom.lv
WHISPERX_API_KEY=your_whisperx_api_key_here

# Transkriptor (slower alternative transcription)
TRANSKRIPTOR_API_KEY=your_transkriptor_api_key_here

# Manus AI
MANUS_API_KEY=your_manus_api_key_here
MANUS_API_URL=https://api.manus.ai/v1
MANUS_PROJECT_ID=hmJt62CYFJXWjLL34mzZMZ

# File paths
VIDEO_PATH=C:/path/to/your/sermon.mp4
AUDIO_PATH=C:/path/to/your/sermon_audio.m4a

# Output
OUTPUT_DIR=./output

# Optional: manually set intro offset in seconds if you know it
# Leave blank to auto-detect
INTRO_OFFSET_SECONDS=
